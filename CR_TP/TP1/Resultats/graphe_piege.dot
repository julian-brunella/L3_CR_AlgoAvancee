graph G {
    node [style=filled];
    0 [fillcolor=red, label="0\n(c0)"];
    1 [fillcolor=red, label="1\n(c0)"];
    2 [fillcolor=blue, label="2\n(c1)"];
    3 [fillcolor=green, label="3\n(c2)"];
    4 [fillcolor=blue, label="4\n(c1)"];
    5 [fillcolor=green, label="5\n(c2)"];
    6 [fillcolor=blue, label="6\n(c1)"];
    7 [fillcolor=green, label="7\n(c2)"];
    0 -- 3;
    0 -- 5;
    0 -- 7;
    1 -- 2;
    1 -- 4;
    1 -- 6;
    2 -- 3;
    4 -- 5;
    6 -- 7;
}

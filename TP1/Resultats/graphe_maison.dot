graph G {
    node [style=filled];
    0 [fillcolor=red, label="0\n(c0)"];
    1 [fillcolor=blue, label="1\n(c1)"];
    2 [fillcolor=red, label="2\n(c0)"];
    3 [fillcolor=blue, label="3\n(c1)"];
    4 [fillcolor=green, label="4\n(c2)"];
    0 -- 1;
    0 -- 3;
    0 -- 4;
    1 -- 2;
    1 -- 4;
    2 -- 3;
}
